{
  "package_type": "agent_template",
  "name": "speech",
  "display_name": {
    "zh": "配音师",
    "en": "Speech Artist"
  },
  "description": "按对白生成配音，并交回音频产物。",
  "persona": {
    "dir": "persona"
  },
  "tools": [
    {
      "file": "tools/read_node_context.py",
      "class": "ReadNodeContext"
    },
    {
      "file": "tools/generate_speech.py",
      "class": "GenerateSpeech"
    },
    {
      "file": "tools/submit_node_output.py",
      "class": "SubmitNodeOutput"
    }
  ],
  "rails": [
    {
      "file": "rails/node_guard.py",
      "class": "NodeGuardRail"
    }
  ],
  "skills": [
    {
      "dir": "skills/speech",
      "mode": "all"
    }
  ],
  "metadata": {
    "node_type": "speech",
    "output_kind": "audio"
  }
}
